# --- Supabase ---------------------------------------------------------------
# Project URL and anon key: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Anthropic --------------------------------------------------------------
# Optional. Without a key, ApplyStack runs in deterministic mock-AI mode:
# job analysis, matching, and tailoring all work using the built-in
# keyword-matching engine, so the whole app remains usable.
ANTHROPIC_API_KEY=
# Model is configurable; never hardcoded in the codebase.
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Job sources ------------------------------------------------------------
# Comma-separated Greenhouse board tokens (https://boards.greenhouse.io/<token>)
# and Lever site names (https://jobs.lever.co/<site>). Optional; you can also
# manage these in Settings -> Job sources. When no live source is reachable,
# the seeded internships keep the board fully usable.
GREENHOUSE_BOARDS=
LEVER_SITES=
