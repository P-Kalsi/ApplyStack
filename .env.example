# Copy to .env.local and fill in what you use. Never commit .env / .env.local.

# --- Demo mode --------------------------------------------------------------
# Set to 1 to try ApplyStack with no Supabase project: one local user, seeded
# internships, data saved to .demo-data.json. Never enable on a deployed site.
APPLYSTACK_DEMO=

# --- Supabase ---------------------------------------------------------------
# Project URL and anon key: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- AI backend ---------------------------------------------------------------
# Pick the backend in Settings -> AI backend (saved to applystack.config.json).
# The default, "claude_cli", uses your own Claude Code login and needs no key.
# Only set the key for the API provider you actually use. Keys are read from
# here only; ApplyStack never writes them to the config file.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional overrides
# APPLYSTACK_LLM_PROVIDER=offline     # force a backend (claude_cli|codex_cli|anthropic|openai|gemini|offline)
# CLAUDE_CLI_PATH=/path/to/claude     # if `claude` isn't on PATH
# CODEX_CLI_PATH=/path/to/codex       # if `codex` isn't on PATH
# APPLYSTACK_CONFIG=/path/to/applystack.config.json

# --- Job sources ------------------------------------------------------------
# Comma-separated Greenhouse board tokens (https://boards.greenhouse.io/<token>)
# and Lever site names (https://jobs.lever.co/<site>). Optional; you can also
# manage these in Settings -> Job sources.
GREENHOUSE_BOARDS=
LEVER_SITES=

# --- Adzuna (local job search) ---------------------------------------------
# Keys at https://developer.adzuna.com (Register -> your app id and key). The
# free tier is a small number of test calls; ongoing use needs a paid plan.
# Leave empty to hide Adzuna in Discover.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=ca

# --- Internship feed & Discord alerts --------------------------------------
# Filters for the Simplify internship feed live in Settings -> Internship feed
# & alerts. For Discord alerts, create a webhook in your server (channel
# settings -> Integrations -> Webhooks) and paste its URL here. Treat it like a
# password: anyone with it can post in that channel.
DISCORD_WEBHOOK_URL=
# Link used in alerts to open ApplyStack (default http://localhost:3000)
# APPLYSTACK_URL=http://localhost:3000
# Override the internship list location (default: SimplifyJobs on GitHub)
# SIMPLIFY_LISTINGS_URL=
